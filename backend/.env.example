# 복사해서 .env 로 저장 후 값 채우기
SECRET_KEY=change-me-to-random-string
# Claude API 키 (없으면 규칙 기반 AI로 동작)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# 기본값: backend/staging.db (SQLite)
# DATABASE_URL=sqlite:///./staging.db
PAYMENT_QR_TTL_SECONDS=60
CORS_ORIGINS=*
DEMO_MODE=true

# 음성 인식 (Whisper)
# groq  : GroqCloud API (기본, whisper-large-v3-turbo) → https://console.groq.com/keys 에서 키 발급
# openai: OpenAI API (whisper-1)
# local : 내 PC에서 실행 (pip install openai-whisper + ffmpeg 필요, 키 불필요)
STT_PROVIDER=groq
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
OPENAI_API_KEY=
# local 일 때 모델 크기: tiny / base / small / medium / large
WHISPER_MODEL=base

# true면 데모용 지난 기록(매출·주문·대화)까지 채움. 기본 false = 빈 상태
SEED_HISTORY=false
